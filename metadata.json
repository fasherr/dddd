import React from 'react';

interface LogoProps {
  size?: 'sm' | 'md' | 'lg';
  variant?: 'local' | 'free' | 'full';
  showBadge?: boolean;
}

export const Logo: React.FC<LogoProps> = ({
  size = 'md',
  variant = 'free',
  showBadge = false,
}) => {
  const iconSizes = {
    sm: 'w-7 h-7',
    md: 'w-9 h-9',
    lg: 'w-11 h-11',
  };

  const textSizes = {
    sm: 'text-base',
    md: 'text-xl',
    lg: 'text-2xl',
  };

  return (
    <div className="inline-flex items-center gap-2.5 select-none">
      {/* Inspired by FreeConvert: Circular violet badge with dual curved cycle arrows */}
      <div
        className={`${iconSizes[size]} rounded-full bg-gradient-to-br from-[#6366f1] via-[#5b54f6] to-[#4f46e5] flex items-center justify-center shadow-md shadow-indigo-500/20 flex-shrink-0 transition-transform hover:scale-105`}
        title="Локальный конвертер FreeConvert style"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          strokeWidth="2.5"
          strokeLinecap="round"
          strokeLinejoin="round"
          className="w-1/2 h-1/2 text-white"
        >
          {/* Top curved arrow going right */}
          <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
          <polyline points="3 3 3 8 8 8" />
          {/* Bottom curved arrow going left */}
          <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
          <polyline points="21 21 21 16 16 16" />
        </svg>
      </div>

      {/* Brand Typography */}
      <div className="flex flex-col leading-none">
        <div className={`font-black tracking-tight ${textSizes[size]} flex items-center`}>
          {variant === 'free' ? (
            <>
              <span className="text-[#5b54f6]">Free</span>
              <span className="text-slate-900">Convert</span>
            </>
          ) : variant === 'local' ? (
            <>
              <span className="text-[#5b54f6]">Local</span>
              <span className="text-slate-900">Convert</span>
            </>
          ) : (
            <>
              <span className="text-[#5b54f6]">Free</span>
              <span className="text-slate-900">Convert</span>
              <span className="ml-1.5 text-xs font-mono font-bold px-1.5 py-0.5 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-200 uppercase">
                Local
              </span>
            </>
          )}
        </div>

        {showBadge && (
          <span className="text-[10px] text-slate-400 font-medium tracking-normal mt-0.5">
            100% браузерная оффлайн-обработка
          </span>
        )}
      </div>
    </div>
  );
};
